{
  "name": "ga-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.6.0 <25", "npm": ">=11 <12" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @ga-com/server\" \"npm run dev -w @ga-com/client\"",
    "build": "npm run build -w @ga-com/game-core && npm run build -w @ga-com/protocol && npm run build -w @ga-com/server && npm run build -w @ga-com/client",
    "start": "npm start -w @ga-com/server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
